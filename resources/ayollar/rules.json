  "optional_when": [
    {
      "question": 10,
      "note": "Ta'limda bo'lgan ayoldan BANDLIK holati majburiy emas. Zinapoya birinchi moslikda to'xtaydi va ta'lim qadamlari (3-7) bandlik qadamlaridan (8-22) OLDIN turadi: maktab o'quvchisi 6-qadamda, talaba 4-qadamda yopiladi va bandlik javobiga umuman yetib borilmaydi. Ya'ni javob toifaga ham, balans qatoriga ham ta'sir qilmaydi - uni talab qilish faqat ortiqcha to'siq. Shart 'yoq' dan BOSHQA qiymat: 'abituriyent' ham 23-qadamda yopiladi. Ta'lim javobi berilmagan bo'lsa ('ne' operatori bo'sh qiymatni rad etadi) bandlik MAJBURIY bo'lib qoladi - aks holda anketa zinapoyadan tushib, balansdan tashqarida qolardi.",
      "when": {
        "field": "education_status",
        "op": "neq",
        "value": "yoq"
      }
    }
